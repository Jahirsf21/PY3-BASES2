                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [brand_id], [brand_name], [category_id], [category_name], [list_price], [model_year], [product_id], [product_name],[start_date],[end_date] FROM [dbo].[DimProducts]</property>
                <property
                  dataType="System.String"
                  description="Especifica la cláusula WHERE de la instrucción SELECT que selecciona la fila actual de entre filas con claves empresariales idénticas."
